# Don't include dependencies
node_modules/

# Don't include compiled scripts
dist-scripts/

# Don't include test coverage reports (regenerated by `npm run test:coverage`)
coverage/

# Don't include local claude settings
.claude/settings.local.json

# Don't include the per-session scheduled-tasks lock (PID + sessionId, runtime only)
.claude/scheduled_tasks.lock

# Don't include environment variable files
*.env

# Don't include SDLC workflow state (local per-developer)
.sdlc/

# Don't include temp directory
temp/